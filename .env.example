# ---------------------------------------------------------------
# POCKET KNIFE – configuration (copy to .env and adjust)
# ---------------------------------------------------------------

# --- Docker / network (read by docker-compose.yml) ---
# DNS servers of the domain (usually the DCs). PK_DNS_2 is optional.
PK_DNS_1=10.0.10.5
PK_DNS_2=10.0.10.6
# DNS search domain (empty = PK_DOMAIN)
#PK_DNS_SEARCH=firma.local
# Data directory on the host – keep it in its own folder (default /opt/pocketknife/data);
# updates never touch it
PK_DATA_PATH=/opt/pocketknife/data
# Optional: mount the software repository as a folder (in the container: /repo)
#PK_REPO_MOUNT=/mnt/software
# Location of the automatic backups (default: <PK_DATA_PATH>-backup). Better another
# drive or a mounted network share, so a disk failure does not hit everything.
#PK_BACKUP_PATH=/mnt/backup/pocketknife
PK_TIMEZONE=Europe/Berlin
# Registry for "sh update.sh --pull" (ready-made image for amd64/arm64 instead of building locally).
# Private registry: once  docker login ghcr.io -u <user>  (token with read:packages) – never put the token here.
#PK_IMAGE_REPO=ghcr.io/soleil0815/pocketknife
# Image of the container. Default: ghcr.io/soleil0815/pocketknife:latest (ready-made, amd64/arm64) – with :latest a
# container manager (Dockhand, Watchtower …) can update automatically. Stay on a version: …/pocketknife:2.28.2.
# Built locally (ZIP update without internet): pocketknife:local – update.sh sets this itself.
#PK_IMAGE=ghcr.io/soleil0815/pocketknife:latest

# Remote sessions in the browser (RDP/VNC) via the container pocketknife-guacd
# Only change if guacd runs elsewhere.
#PK_GUACD_HOST=guacd
#PK_GUACD_PORT=4822
# Since 2.14.2 the guacd version is pinned with digest in docker-compose.yml (tools/pin-versions.sh --update)

# Domain
PK_DOMAIN=firma.local
PK_NETBIOS=FIRMA
# Domain controllers for LDAPS (comma-separated). Empty = PK_DOMAIN
PK_LDAP_SERVERS=dc1.firma.local,dc2.firma.local
PK_LDAP_PORT=636
# Optional: CA of the domain (PEM, place it in the data directory) for a full check of the LDAPS certificate.
# Without: each DC's certificate is remembered on first contact and compared before every login.
#PK_LDAP_CA_FILE=/data/ca.pem
# Optional: CA (PEM) to verify the client certificates for WinRM over HTTPS. Without: not verified.
#PK_WINRM_CA_FILE=/data/winrm-ca.pem
# Optional, otherwise derived from PK_DOMAIN
#PK_BASE_DN=DC=firma,DC=local
# Initial value for where computers are searched (";"-separated). Since 2.2 editable under Settings → Active Directory.
#PK_COMPUTER_BASE_DN=OU=Clients,DC=firma,DC=local;OU=Server,DC=firma,DC=local

# AD group whose members may use POCKET KNIFE (name or DN, nesting allowed)
PK_ACCESS_GROUP=POCKETKNIFE-Admins

# Service account: LDAP read access + local administrator on all clients
# Since 2.2 better stored in the web interface (Settings → Service account) – stored encrypted there.
# The two lines below can then be removed.
PK_SERVICE_USER=svc-pocketknife
PK_SERVICE_PASSWORD=PleaseChange!
# Alternatively as a Docker secret: PK_SERVICE_PASSWORD_FILE=/run/secrets/pk_service_password

# WinRM to the clients
# Authentication for WinRM and SMB: ntlm | negotiate (Kerberos, otherwise NTLM) | kerberos (Kerberos only)
# Since 2.6 also switchable under Settings → Connection & accounts → Authentication (with test).
PK_WINRM_AUTH=ntlm
# Kerberos: domain controllers are found via DNS. Only set if that does not work:
#PK_KDC=dc1.firma.local,dc2.firma.local
# Realm, if different from PK_DOMAIN (upper case is applied automatically)
#PK_KERBEROS_REALM=FIRMA.LOCAL
PK_WINRM_HTTPS=false
#PK_WINRM_PORT=5985

# Optional: separate account for the software repository (default = service account)
#PK_REPO_USER=svc-pkrepo
#PK_REPO_PASSWORD=

# Web server
PK_HTTPS=true
PK_PORT=8443
PK_PUBLIC_HOSTNAME=pocketknife.firma.local
PK_SESSION_HOURS=10

# Optional: emergency access without AD (only set if really needed)
#PK_BREAKGLASS_USER=emergency
#PK_BREAKGLASS_PASSWORD=

# Optional: user/group ID in the container (since 2.14 POCKET KNIFE no longer runs as root).
# At start /data and /backup are handed over to this user. A mounted repository folder must be readable for it.
#PK_UID=10001
#PK_GID=10001
